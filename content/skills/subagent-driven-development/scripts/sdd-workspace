#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for its short-lived
# artifacts: task briefs, implementer reports, review packages, and the
# progress ledger. Print the directory's absolute path.
#
# The workspace lives in the working tree, not under .git/, because Codex's
# workspace-write sandbox denies writes there and would block an implementer
# subagent from writing its report file.
#
# The ignore file sits at .agent/, not .agent/sdd/: a sibling .agent/campaigns/
# written later by $campaign has to be covered too, and whichever skill ran
# first would otherwise decide whether the next one's state is ignored.
#
# Single source of truth for the workspace location, so task-brief and
# review-package cannot drift to different directories.
#
# Usage: sdd-workspace
set -euo pipefail

root=$(git rev-parse --show-toplevel)

# Refuse rather than clobber: .agent/ is a generic name and a repository may
# track its own .agent/.gitignore. Output is discarded because this command
# exits non-zero and prints to stderr on the ordinary untracked path, which
# would otherwise kill this script under `set -e`.
if git -C "$root" ls-files --error-unmatch .agent/.gitignore >/dev/null 2>&1; then
	printf 'sdd-workspace: %s/.agent/.gitignore is tracked here; refusing to overwrite it\n' \
		"$root" >&2
	exit 1
fi

dir="$root/.agent/sdd"
mkdir -p "$dir"

# Write through a temp file and rename: a plain redirect truncates before it
# writes, and $campaign's fail-closed `git check-ignore` reading that gap sees an
# empty ignore file, reports the manifest unignored, and stops the run. rename(2)
# is atomic within the directory, so a concurrent reader sees one version or the
# other and never the gap.
tmp="$root/.agent/.gitignore.$$"
printf '*\n' >"$tmp"
mv -f "$tmp" "$root/.agent/.gitignore"

cd "$dir" && pwd
